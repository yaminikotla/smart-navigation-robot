<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <!-- ==================== MATERIALS ==================== -->

    <material name="blue">
        <color rgba="0.1 0.3 0.9 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>



    <!-- ==================== INERTIA MACROS ==================== -->

    <xacro:macro name="inertial_box" params="mass x y z">
        <inertial>
            <mass value="${mass}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia
                ixx="${(mass/12.0) * (y*y + z*z)}"
                ixy="0"
                ixz="0"
                iyy="${(mass/12.0) * (x*x + z*z)}"
                iyz="0"
                izz="${(mass/12.0) * (x*x + y*y)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_cylinder" params="mass length radius">
        <inertial>
            <mass value="${mass}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia
                ixx="${(mass/12.0) * (3*radius*radius + length*length)}"
                ixy="0"
                ixz="0"
                iyy="${(mass/12.0) * (3*radius*radius + length*length)}"
                iyz="0"
                izz="${(mass/2.0) * radius*radius}"/>
        </inertial>
    </xacro:macro>

    <!-- ==================== MAIN ROBOT BODY ==================== -->

    <link name="base_link"/>

    <!-- ==================== CHASSIS ==================== -->

    <link name="chassis">
        <visual>
            <geometry>
                <box size="0.6 0.4 0.15"/>
            </geometry>

            <origin xyz="0 0 0.075" rpy="0 0 0"/>

            <material name="blue"/>
        </visual>

        <collision>
            <geometry>
                <box size="0.6 0.4 0.15"/>
            </geometry>

            <origin xyz="0 0 0.075" rpy="0 0 0"/>
        </collision>

        <xacro:inertial_box
            mass="5.0"
            x="0.6"
            y="0.4"
            z="0.15"/>
    </link>

    <joint name="base_to_chassis" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
    </joint>


    <!-- ==================== LiDAR FRAME ==================== -->

    <link name="laser_link">
    <visual>
        <geometry>
            <cylinder radius="0.07" length="0.05"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="orange">
            <color rgba="1.0 0.4 0.0 1.0"/>
        </material>
    </visual>

        <collision>
            <geometry>
                <cylinder radius="0.07" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    <sensor name="lidar_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>laser_link</gz_frame_id>

        <lidar>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
            </scan>

            <range>
                <min>0.12</min>
                <max>10.0</max>
                <resolution>0.01</resolution>
            </range>
        </lidar>
    </sensor>
</link>

    <joint name="base_to_laser" type="fixed">
        <parent link="chassis"/>
        <child link="laser_link"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </joint>


    <!-- ==================== FRONT LEFT WHEEL ==================== -->

    <link name="front_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>

            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <material name="black"/>
        </visual>
    
        <collision>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>

            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>

        <xacro:inertial_cylinder
            mass="0.5"
            length="0.04"
            radius="0.08"/>
</link>

    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="front_left_wheel"/>
        <origin xyz="0.2 0.23 0.0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>


    <!-- ==================== FRONT RIGHT WHEEL ==================== -->

    <link name="front_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>

            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <material name="black"/>
        </visual>
    
        <collision>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>

            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>

        <xacro:inertial_cylinder
            mass="0.5"
            length="0.04"
            radius="0.08"/>
</link>

    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="front_right_wheel"/>
        <origin xyz="0.2 -0.23 0.0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>


    <!-- ==================== REAR LEFT WHEEL ==================== -->

    <link name="rear_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>

            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <material name="black"/>
        </visual>
    
        <collision>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>

            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>

        <xacro:inertial_cylinder
            mass="0.5"
            length="0.04"
            radius="0.08"/>
</link>

    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="rear_left_wheel"/>
        <origin xyz="-0.2 0.23 0.0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>


    <!-- ==================== REAR RIGHT WHEEL ==================== -->

    <link name="rear_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>

            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <material name="black"/>
        </visual>
    
        <collision>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>

            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>

        <xacro:inertial_cylinder
            mass="0.5"
            length="0.04"
            radius="0.08"/>
</link>

    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="rear_right_wheel"/>
        <origin xyz="-0.2 -0.23 0.0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>


    <!-- ros2_control configuration for Gazebo -->
    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="front_left_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="front_right_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="rear_left_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="rear_right_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <!-- Gazebo ros2_control plugin -->
    <gazebo>
        <plugin
            filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find smart_navigation_robot)/config/my_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
